# 本地开发数据库
DATABASE_URL="postgresql://code_review:code_review@localhost:5433/code_review_copilot?schema=public"
PORT=8787
APP_PORT=8787
APP_PUBLIC_URL="http://localhost:8787"

# 登录凭证；会话密钥用于生成数据库凭证摘要
APP_AUTH_USERNAME="admin"
APP_AUTH_SECRET=""
APP_AUTH_SESSION_SECRET=""

# Docker 数据库密码使用 URL 安全字符
POSTGRES_PASSWORD=""

LOG_LEVEL="info"
WORKSPACE_ROOT="./.workspaces"
WORKSPACE_TTL_HOURS=72
TMPDIR="./.workspaces/tmp"

# 安全测试运行目录
SECURITY_ARTIFACTS_ROOT="./.security-artifacts"
SECURITY_SKILLS_ROOT="./security-skills"
SECURITY_ACTION_POLICY="./security-skills/hack/action-policy.json"
AGENT_BROWSER_BIN="./node_modules/.bin/agent-browser"
ZAP_API_URL=""

# 留空时不启动遥测。Docker Compose 自动设置统一 Collector 地址。
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
OTEL_EXPORTER_OTLP_INSECURE="true"
OTEL_SERVICE_NAME="code-review-copilot"
OTEL_RESOURCE_ATTRIBUTES="service.namespace=code-review"
