{
  "uid": "review-platform",
  "title": "代码审查运行",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "运行数量",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (status) (increase(review_run_count_total[$__rate_interval]))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 2,
      "title": "运行耗时 P95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, status) (rate(review_run_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 3,
      "title": "服务健康状态",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}" }]
    },
    {
      "id": 4,
      "title": "审查追踪",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "queryType": "traceql", "query": "{ resource.service.name = \"code-review-copilot\" && name = \"review.run\" }", "limit": 50, "tableType": "traces" }]
    },
    {
      "id": 5,
      "title": "执行阶段数量",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (name, status) (increase(review_operation_count_total[$__rate_interval]))", "legendFormat": "{{name}} / {{status}}" }]
    },
    {
      "id": 6,
      "title": "执行阶段耗时 P95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, name, status) (rate(review_operation_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{name}} / {{status}}" }]
    },
    {
      "id": 7,
      "title": "Token 消耗",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "review-postgres" },
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "postgres", "uid": "review-postgres" },
        "format": "table",
        "rawQuery": true,
        "editorMode": "code",
        "rawSql": "SELECT COALESCE(sum((r.\"rawResult\" #>> '{summary,total_tokens}')::bigint), 0) AS \"Token 消耗\" FROM runs r WHERE jsonb_typeof(r.\"rawResult\" #> '{summary,total_tokens}') = 'number' AND $__timeFilter(r.\"createdAt\")"
      }]
    },
    {
      "id": 8,
      "title": "Token 消耗趋势",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "review-postgres" },
      "gridPos": { "x": 6, "y": 24, "w": 18, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "postgres", "uid": "review-postgres" },
        "format": "time_series",
        "rawQuery": true,
        "editorMode": "code",
        "rawSql": "SELECT $__timeGroupAlias(r.\"createdAt\", $__interval), r.\"modelId\" AS metric, sum((r.\"rawResult\" #>> '{summary,total_tokens}')::bigint) AS value FROM runs r WHERE jsonb_typeof(r.\"rawResult\" #> '{summary,total_tokens}') = 'number' AND $__timeFilter(r.\"createdAt\") GROUP BY 1, 2 ORDER BY 1",
        "legendFormat": "{{metric}}"
      }]
    },
    {
      "id": 9,
      "title": "单次任务 Token 消耗",
      "description": "按 Run 展示 OCR 汇总的输入、输出、总 Token 和缓存读取 Token。",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "review-postgres" },
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 12 },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "postgres", "uid": "review-postgres" },
        "format": "table",
        "rawQuery": true,
        "editorMode": "code",
        "rawSql": "SELECT r.id AS \"Run ID\", r.\"createdAt\" AS \"时间\", r.status AS \"状态\", COALESCE(repository.name, '') AS \"仓库\", r.\"modelId\" AS \"模型\", COALESCE((r.\"rawResult\" #>> '{summary,input_tokens}')::bigint, 0) AS \"输入 Token\", COALESCE((r.\"rawResult\" #>> '{summary,output_tokens}')::bigint, 0) AS \"输出 Token\", COALESCE((r.\"rawResult\" #>> '{summary,total_tokens}')::bigint, 0) AS \"总 Token\", COALESCE((r.\"rawResult\" #>> '{summary,cache_read_tokens}')::bigint, 0) AS \"缓存读取 Token\" FROM runs r LEFT JOIN repositories repository ON repository.id = r.\"repositoryId\" WHERE jsonb_typeof(r.\"rawResult\" #> '{summary,total_tokens}') = 'number' AND $__timeFilter(r.\"createdAt\") ORDER BY r.\"createdAt\" DESC LIMIT 200"
      }],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "Token$" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "时间" }, "properties": [{ "id": "unit", "value": "dateTimeAsIso" }] },
          { "matcher": { "id": "byName", "options": "Run ID" }, "properties": [{ "id": "custom.width", "value": 300 }] },
          { "matcher": { "id": "byName", "options": "仓库" }, "properties": [{ "id": "custom.width", "value": 180 }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "时间", "desc": true }] }
    }
  ]
}
