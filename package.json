{
  "name": "code-review-copilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:db": "tsx scripts/dev-postgres.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "prisma generate && vite build",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@ai-sdk/react": "^4.0.2",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/cjk": "^1.0.3",
    "ai": "^7.0.2",
    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "dotenv": "^16.4.7",
    "gsap": "^3.15.0",
    "hono": "^4.6.14",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.563.0",
    "motion": "^14.2.0",
    "nanoid": "^6.0.2",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^4.14.5",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.9.1",
    "rss-parser": "^3.13.0",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.19.2",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
