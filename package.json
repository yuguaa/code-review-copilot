{
  "name": "code-review-copilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:db": "tsx scripts/dev-postgres.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:security-worker": "tsx watch server/platform/security/index.ts",
    "dev:web": "vite",
    "build": "prisma generate && vite build",
    "start": "node --import tsx server/index.ts",
    "start:security-worker": "node --import tsx server/platform/security/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:platform": "node --import tsx scripts/verify-platform.ts",
    "verify:components": "node scripts/verify-component-mcp.mjs",
    "verify:browser": "node scripts/verify-deployed-browser.mjs",
    "verify:security-api": "tsx scripts/verify-security-api.ts",
    "verify:security-browser": "node scripts/verify-security-browser.mjs",
    "verify:security-deployed": "node scripts/verify-deployed-security.mjs",
    "verify:security-tools": "tsx scripts/verify-security-tools.ts",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@ai-sdk/react": "^4.0.2",
    "@alibaba-group/open-code-review": "1.9.10",
    "@base-ui/react": "^1.9.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^1.13.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@shadcn/react": "0.3.1",
    "@streamdown/cjk": "^1.0.3",
    "agent-browser": "0.39.1",
    "ai": "^7.0.2",
    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "lucide-react": "^0.563.0",
    "parse5": "^7.3.0",
    "pino": "^10.3.1",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.1.1",
    "rss-parser": "^3.13.0",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.4.0",
    "typebox": "1.3.27",
    "uuid": "11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.19.2",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
