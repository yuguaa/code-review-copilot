generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GitLabAccount {
  id            String       @id @default(cuid())
  url           String
  accessToken   String
  webhookSecret String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  repositories  Repository[]

  @@map("gitlab_accounts")
}

model AIModel {
  id           String       @id @default(cuid())
  provider     String
  modelId      String
  apiKey       String
  apiBaseUrl   String?
  maxSteps     Int          @default(16)
  isDefault    Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  repositories Repository[]

  @@map("ai_models")
}

model Repository {
  id                  String        @id @default(cuid())
  gitLabAccountId     String
  gitLabAccount       GitLabAccount @relation(fields: [gitLabAccountId], references: [id], onDelete: Cascade)
  gitLabProjectId     Int
  name                String
  path                String
  description         String?
  watchBranches       String?
  autoReview          Boolean       @default(true)
  defaultAIModelId    String?
  defaultAIModel      AIModel?      @relation(fields: [defaultAIModelId], references: [id], onDelete: SetNull)
  customProvider      String?
  customModelId       String?
  customApiKey        String?
  customApiBaseUrl    String?
  customMaxSteps      Int?
  ocrConcurrency      Int           @default(2)
  ocrTimeoutMinutes   Int           @default(10)
  ocrMaxTokensBudget  Int           @default(200000)
  defaultReviewPrompt String?
  enableMrComment     Boolean       @default(false)
  enableDingtalk      Boolean       @default(false)
  dingtalkRobotId     String?
  dingtalkRobot       DingtalkRobot? @relation(fields: [dingtalkRobotId], references: [id], onDelete: Restrict)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  sessions            Session[]
  runs                Run[]

  @@unique([gitLabProjectId, gitLabAccountId])
  @@index([defaultAIModelId])
  @@map("repositories")
}

model Session {
  id                  String      @id @default(cuid())
  kind                String      @default("review")
  title               String?
  repositoryId        String?
  repository          Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  mrIid               Int?
  mrTitle             String?
  sourceBranch        String?
  targetBranch        String?
  baseCommitSha       String?
  commitSha           String?
  author              String?
  status              String      @default("completed")
  error               String?
  activeLeafMessageId String?
  activeLeafMessage   Message?    @relation("SessionActiveLeaf", fields: [activeLeafMessageId], references: [id], onDelete: SetNull)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  messages            Message[]   @relation("SessionMessages")
  runs                Run[]

  @@index([kind, updatedAt])
  @@index([repositoryId])
  @@map("sessions")
}

/// 每次执行保存确定的输入、原始输出、报告位置与发布结果。
model Run {
  id              String      @id @default(cuid())
  sessionId       String
  session         Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  repositoryId    String?
  repository      Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  engineKey       String
  engineVersion   String?
  engineSessionId String?
  triggerType     String      @default("manual")
  eventKey        String?     @unique
  status          String      @default("queued")
  baseSha         String?
  startSha        String?
  headSha         String?
  provider        String?
  modelId         String?
  traceId         String?
  input           Json?
  inputMessageId  String?
  reportMessageId String?     @unique
  exitCode        Int?
  deliveries      Json        @default("{}")
  rawResult       Json?
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([sessionId, createdAt])
  @@index([repositoryId, createdAt])
  @@index([status, createdAt])
  @@map("runs")
}

model AuthSession {
  id        String   @id
  tokenHash String   @unique
  username  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("auth_sessions")
}

model Message {
  id                String    @id @default(cuid())
  sessionId         String
  session           Session   @relation("SessionMessages", fields: [sessionId], references: [id], onDelete: Cascade)
  activeForSessions Session[] @relation("SessionActiveLeaf")
  parentId          String?
  parent            Message?  @relation("MessageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Message[] @relation("MessageTree")
  role              String
  parts             Json
  createdAt         DateTime  @default(now())

  @@index([sessionId, createdAt])
  @@index([parentId, createdAt])
  @@map("messages")
}

model DingtalkRobot {
  id               String   @id @default(cuid())
  name             String
  webhookUrl       String
  secret           String?
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  repositories     Repository[]
  rssSubscriptions RssSubscription[]

  @@map("dingtalk_robots")
}

model RssSubscription {
  id              String          @id @default(cuid())
  name            String
  url             String          @unique
  enabled         Boolean         @default(true)
  intervalMinutes Int             @default(30)
  dingtalkRobotId  String?
  dingtalkRobot    DingtalkRobot?   @relation(fields: [dingtalkRobotId], references: [id], onDelete: Restrict)
  lastFetchedAt   DateTime?
  lastError       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items           RssPushedItem[]

  @@map("rss_subscriptions")
}

model RssPushedItem {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   RssSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  guid           String
  title          String
  link           String?
  publishedAt    DateTime?
  pushedAt       DateTime        @default(now())

  @@unique([subscriptionId, guid])
  @@index([subscriptionId, pushedAt])
  @@map("rss_pushed_items")
}
